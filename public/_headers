/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Sveltia CMS loads from unpkg and talks to the GitHub API; it keeps the
# other headers but not the strict site CSP. The page is served at /admin
# (trailing slashes are dropped), so both rules are needed.
/admin
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; media-src 'self' blob: https:; connect-src 'self' data: blob: https://api.github.com https://github.com https://*.githubusercontent.com https://www.githubstatus.com https://unpkg.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; media-src 'self' blob: https:; connect-src 'self' data: blob: https://api.github.com https://github.com https://*.githubusercontent.com https://www.githubstatus.com https://unpkg.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
