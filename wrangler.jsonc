// Cloudflare Worker for ChiloLab. Pages are answered from ./dist (including
// _headers and _redirects); worker/index.ts only runs for /api/* and /manage*.
// Setup steps: docs/DATABASE.md.
{
  "name": "chilolab-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/manage", "/manage/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chilolab",
      "database_id": "d1c3e34e-6ddf-4761-ae7f-0c58f15371f6",
      "migrations_dir": "migrations",
    },
  ],
  // Public values only. TURNSTILE_SECRET is a secret: `wrangler secret put`.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "bold-night-e762.cloudflareaccess.com",
    "ACCESS_AUD": "6c22982b14601e675f0981e5ac990f1feaeec85103cfaca0ac173f5c22b3a337",
  },
}
