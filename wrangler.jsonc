// Cloudflare Worker for ChiloLab. Pages are answered from ./dist (including
// _headers and _redirects); worker/index.ts only runs for /api/*, /admin/manage*, /manage*
// and the /user redirects. Setup steps: docs/DATABASE.md.
{
  "name": "chilolab-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Cloudflare creates the DNS records and certificates for these hostnames.
  // www.chilolab.com is redirected to the apex by a zone Redirect Rule.
  "routes": [
    { "pattern": "chilolab.com", "custom_domain": true },
    { "pattern": "www.chilolab.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      // Videos need byte ranges to seek and replay (worker/media.ts).
      "/media/*",
      // Sveltia CMS: owner session only (worker/cms.ts).
      "/admin",
      "/admin/index.html",
      "/admin/config.yml",
      "/admin/manage",
      "/admin/manage/*",
      "/manage",
      "/manage/*",
      "/user",
      "/en/user",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chilolab",
      "database_id": "d1c3e34e-6ddf-4761-ae7f-0c58f15371f6",
      "migrations_dir": "migrations",
    },
  ],
  // Daily upkeep at 19:00 UTC (02:00 Vietnam): cleanup, and on Sundays UTC a
  // D1 backup to R2 (worker/maintenance.ts).
  "triggers": { "crons": ["0 19 * * *"] },
  // Weekly D1 backups: private bucket, created 2026-11-26 (docs/DATABASE.md).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "chilolab-backups" }],
  // Workers AI: comment moderation (worker/moderation.ts). Free daily quota.
  "ai": { "binding": "AI" },
  // Loose per-user / per-IP write limit for comments and feedback.
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Workers Logs: errors and console output in the dashboard.
  "observability": { "enabled": true },
  // Public values only. Secrets (TURNSTILE_SECRET, GOOGLE_CLIENT_SECRET,
  // RESEND_API_KEY, CMS_GITHUB_TOKEN) are
  // set with `wrangler secret put` or in the dashboard.
  "vars": {
    "GOOGLE_CLIENT_ID": "354598476641-kjo3ve152771g4boncv5rooshqd7bmqt.apps.googleusercontent.com",
    "MAIL_FROM": "ChiloLab <no-reply@chilolab.com>",
  },
}
