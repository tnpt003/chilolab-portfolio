# Store and check out text as LF on every OS (Prettier also writes LF).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
