{
  "name": "chilolab-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:browser": "playwright test",
    "test:container": "node scripts/smoke-container.mjs",
    "check": "astro check",
    "verify": "npm run check && npm run check:worker && npm run build && node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:worker": "tsc -p worker",
    "db:migrate:local": "wrangler d1 migrations apply chilolab --local",
    "db:migrate:remote": "wrangler d1 migrations apply chilolab --remote",
    "dev:worker": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "astro": "^7.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.168.0"
  }
}
