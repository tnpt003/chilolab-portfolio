---
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
import WindowBar from './WindowBar.astro';
import Gallery from './Gallery.astro';
import InstallSteps from './InstallSteps.astro';
import { getUi, pathFor } from '../lib/content';
import {
  alwaysLatest,
  featuredDownload,
  listVersions,
  versionCopy,
  versionPath,
} from '../lib/versions';
import VersionList from './VersionList.astro';
import Comments from './Comments.astro';
import { feedbackPath } from '../lib/community';
import DownloadCounter from './DownloadCounter.astro';
import DownloadStat from './DownloadStat.astro';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const t = (await getUi(data.locale)).site;
const versions = await listVersions(data.locale, data.slug);
const v = versionCopy[data.locale];
const latest = (
  await featuredDownload(data.locale, data.slug, data.featuredVersion)
)?.data;
const { Content } = await render(project);
const hasLinks = Boolean(data.demoUrl || data.downloadUrl);
const poster =
  data.video && data.preview
    ? (await getImage({ src: data.preview.image, width: 800, format: 'webp' }))
        .src
    : undefined;
---

<Base
  title={data.title}
  description={data.description}
  locale={data.locale}
  slug={data.slug}
>
  <div class="project-detail wrap">
    <a class="back" href={`${pathFor(data.locale)}#projects`}>
      {t.back}
    </a>
    <header class="detail-heading">
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
    </header>
    {latest ? (
      <section class="download-panel" aria-labelledby="download-heading">
        <div>
          <h2 id="download-heading">{v.latestHeading}</h2>
          <p class="download-release">
            <strong>v{latest.version}</strong>
            <span>{latest.title}</span>
            {latest.releasedAt && (
              <time datetime={latest.releasedAt}>{latest.releasedAt}</time>
            )}
            <DownloadStat project={data.slug} locale={data.locale} />
          </p>
        </div>
        <div class="actions">
          <a
            class="button"
            href={alwaysLatest(latest.downloadUrl!)}
            data-download={`${data.slug}/${latest.version}/setup`}
          >
            <Icon name="download" />
            {v.latestInstaller.replace('{project}', data.title)}
          </a>
          {latest.portableUrl && (
            <a
              href={alwaysLatest(latest.portableUrl)}
              data-download={`${data.slug}/${latest.version}/portable`}
            >
              <Icon name="archive" />
              {v.portable}
            </a>
          )}
          <a href={versionPath(data.locale, data.slug, latest.version)}>
            <Icon name="history" />
            {v.latestNotes}
          </a>
          <a href={feedbackPath(data.locale, data.slug)}>
            <Icon name="message" />
            {v.feedback}
          </a>
        </div>
        {data.downloadNote && (
          <p class="download-note">
            <Icon name="shield" />
            <span>
              {data.downloadNote}{' '}
              {data.install.length > 0 && (
                <a href="#install-heading">
                  {data.locale === 'vi' ? 'Xem từng bước' : 'See each step'}
                </a>
              )}
            </span>
          </p>
        )}
      </section>
    ) : null}
    {/* The video poster is the same screenshot; show it only once. */}
    {!data.video && (
      <ProjectVisual
        kind={data.kind}
        label={t.preview}
        title={data.title}
        meta={latest ? `v${latest.version}` : undefined}
        preview={data.preview}
      />
    )}
    {data.video && (
      <figure class="project-video">
        <div class="window">
          <WindowBar title={data.title} />
          <video
            poster={poster}
            controls
            preload="none"
            width="1280"
            height="720"
            aria-label={
              data.locale === 'vi'
                ? 'Video giới thiệu Pet Desktop'
                : 'Pet Desktop introduction video'
            }
          >
            <source src={data.video} type="video/mp4" />
            <a href={data.video}>
              {data.locale === 'vi' ? 'Mở video' : 'Open video'}
            </a>
          </video>
        </div>
        {data.videoCaption && <figcaption>{data.videoCaption}</figcaption>}
      </figure>
    )}
    {data.gallery.length > 0 && (
      <Gallery shots={data.gallery} locale={data.locale} />
    )}
    {data.install.length > 0 && (
      <InstallSteps steps={data.install} locale={data.locale} />
    )}
    {/* Without side links, the versions sit beside the text so the
        readable column does not leave the right side empty. */}
    <div class:list={['detail-body', { 'with-versions': !hasLinks }]}>
      {hasLinks && (
        <aside class="notice">
          <div class="actions">
            {data.demoUrl && (
              <a class="button" href={data.demoUrl}>
                {t.demo}
              </a>
            )}
            {data.downloadUrl && <a href={data.downloadUrl}>{t.download}</a>}
          </div>
        </aside>
      )}
      <article class="prose">
        <Content />
      </article>
      {!hasLinks && (
        <section class="version-section" aria-labelledby="version-heading">
          <div class="section-heading">
            <h2 id="version-heading">{v.heading}</h2>
            <a href={versionPath(data.locale, data.slug)}>{v.all}</a>
          </div>
          <VersionList entries={versions.slice(0, 3)} locale={data.locale} />
        </section>
      )}
    </div>
    {hasLinks && (
      <section class="version-section" aria-labelledby="version-heading">
        <div class="section-heading">
          <h2 id="version-heading">{v.heading}</h2>
          <a href={versionPath(data.locale, data.slug)}>{v.all}</a>
        </div>
        <VersionList entries={versions.slice(0, 3)} locale={data.locale} />
      </section>
    )}
    <Comments locale={data.locale} project={data.slug} />
  </div>
  <DownloadCounter />
</Base>
