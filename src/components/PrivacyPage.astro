---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPrivacy, type Locale } from '../lib/content';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// Text lives in src/content/privacy/<locale>/{site,app}.md (CMS: Quyền riêng tư).
const { site, app } = await getPrivacy(locale);
const { Content: SiteContent } = await render(site);
const { Content: AppContent } = await render(app);
const { data } = site;
---

<Base
  title={data.title}
  description={data.description!}
  locale={locale}
  slug="privacy"
>
  <article class="wrap prose privacy-page">
    <h1>{data.title}</h1>
    <p class="lead">{data.lead}</p>
    <p>
      {data.updatedLabel}
      <time datetime={data.updated}>{data.updated}</time>
    </p>
    <SiteContent />
    {/* The app's EULA links to this anchor; keep the id. */}
    <h2 id="desktop-pet">{app.data.title}</h2>
    <AppContent />
  </article>
</Base>
