---
import Base from '../layouts/Base.astro';
import { pathFor, type Locale } from '../lib/content';
import { privacyPath, userCopy, userPath } from '../lib/community';
interface Props {
  locale: Locale;
  mode: 'login' | 'account';
}
const { locale, mode } = Astro.props;
const t = userCopy[locale];
const title = mode === 'login' ? t.loginTitle : t.accountTitle;
// Public by design; the matching secret lives in the Worker.
const siteKey: string =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<Base
  title={title}
  description={t.loginIntro}
  locale={locale}
  slug={`user/${mode}`}
  noindex
>
  <div
    class="wrap user-page"
    data-user-page={mode}
    data-locale={locale}
    data-login={userPath(locale, 'login')}
    data-account={userPath(locale, 'account')}
    data-home={pathFor(locale)}
    data-sitekey={siteKey}
    data-copy={JSON.stringify(t)}
  >
    {mode === 'account' && <h1>{title}</h1>}
    {mode === 'login' ? (
      <section class="login-card" aria-labelledby="login-heading">
        <span class="brand-mark login-mark" aria-hidden="true">
          c.
        </span>
        <h1 id="login-heading">{t.loginHeading}</h1>
        <p class="login-intro">{t.loginIntro}</p>
        <p class="form-status" data-error role="alert" />
        <a class="button google-button" data-google href="/api/auth/google">
          <svg aria-hidden="true" viewBox="0 0 48 48" width="20" height="20">
            <path
              fill="#FFC107"
              d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"
            />
            <path
              fill="#FF3D00"
              d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
            />
            <path
              fill="#4CAF50"
              d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"
            />
            <path
              fill="#1976D2"
              d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"
            />
          </svg>
          {t.google}
        </a>
        <div class="login-email" data-email-block hidden>
          <p class="login-divider">
            <span>{t.or}</span>
          </p>
          <form class="login-form" data-email-form novalidate>
            <label for="login-email">{t.emailLabel}</label>
            <input
              id="login-email"
              type="email"
              name="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder={t.emailPlaceholder}
            />
            <div class="turnstile" data-turnstile />
            <button class="button" type="submit">
              {t.sendCode}
            </button>
          </form>
          <form class="login-form" data-code-form hidden novalidate>
            <p class="login-note" data-code-sent />
            <label for="login-code">{t.codeLabel}</label>
            <input
              id="login-code"
              name="code"
              required
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6}"
              maxlength="6"
            />
            <button class="button" type="submit">
              {t.verify}
            </button>
            <p class="login-links">
              <button class="text-button" type="button" data-resend>
                {t.resend}
              </button>
              <button class="text-button" type="button" data-change>
                {t.changeEmail}
              </button>
            </p>
          </form>
          <p class="form-status" data-email-status role="status" />
        </div>
        <p class="login-note">{t.newAccount}</p>
        <p class="login-legal">
          {t.agree} <a href={privacyPath(locale)}>{t.privacy}</a>.
        </p>
      </section>
    ) : (
      <div class="user-account" data-account-body hidden>
        <section class="user-card">
          <p>
            {t.signedInAs} <strong data-email />
          </p>
          <form class="community-form" data-name-form>
            <label for="display-name">{t.displayName}</label>
            <input
              id="display-name"
              name="displayName"
              required
              minlength="2"
              maxlength="40"
              autocomplete="nickname"
              aria-describedby="display-name-hint"
            />
            <p class="field-hint" id="display-name-hint">
              {t.displayNameHint}
            </p>
            <button class="button" type="submit">
              {t.save}
            </button>
            <p class="form-status" data-status role="status" />
          </form>
          <button class="text-button" type="button" data-sign-out>
            {t.signOut}
          </button>
        </section>
        <section class="user-card danger-zone" aria-labelledby="delete-heading">
          <h2 id="delete-heading">{t.deleteTitle}</h2>
          <p>{t.deleteIntro}</p>
          <button class="button danger-button" type="button" data-delete>
            {t.deleteButton}
          </button>
          <p class="form-status" data-delete-status role="status" />
        </section>
      </div>
    )}
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-user-page]');
  if (root) {
    type Copy = { [key: string]: string } & {
      errors: Record<string, string>;
      emailErrors: Record<string, string>;
    };
    const copy = JSON.parse(root.dataset.copy ?? '{}') as Copy;
    const locale = root.dataset.locale!;
    const params = new URLSearchParams(location.search);
    const back = params.get('return');
    const safeBack =
      back && back.startsWith('/') && !back.startsWith('//') ? back : null;
    const me = fetch('/api/me')
      .then((response) => (response.ok ? response.json() : { user: null }))
      .catch(() => ({ user: null, providers: {} }));

    if (root.dataset.userPage === 'login') {
      const error = root.querySelector<HTMLElement>('[data-error]')!;
      const google = root.querySelector<HTMLAnchorElement>('[data-google]')!;
      const code = params.get('error');
      if (code) error.textContent = copy.errors[code] ?? copy.errors.google;
      google.href = `/api/auth/google?${new URLSearchParams({
        locale,
        return: safeBack ?? root.dataset.account!,
      })}`;
      me.then((data) => {
        if (data.user) location.replace(safeBack ?? root.dataset.account!);
        else if (data.providers && !data.providers.google) {
          error.textContent = copy.unavailable;
          google.setAttribute('aria-disabled', 'true');
          google.removeAttribute('href');
        }
        if (data.providers?.email) setupEmail();
      });

      // Email + 6-digit code. Turnstile loads only once the email field is used.
      function setupEmail() {
        type Turnstile = {
          render: (
            el: HTMLElement,
            options: Record<string, unknown>,
          ) => string | undefined;
          reset: (id?: string) => void;
        };
        const block = root!.querySelector<HTMLElement>('[data-email-block]')!;
        const emailForm =
          block.querySelector<HTMLFormElement>('[data-email-form]')!;
        const codeForm =
          block.querySelector<HTMLFormElement>('[data-code-form]')!;
        const status = block.querySelector<HTMLElement>('[data-email-status]')!;
        const emailInput = emailForm.querySelector<HTMLInputElement>('input')!;
        const codeInput = codeForm.querySelector<HTMLInputElement>('input')!;
        const slot = emailForm.querySelector<HTMLElement>('[data-turnstile]')!;
        const errors = copy.emailErrors;
        let token = '';
        let widget: string | undefined;
        let api: Turnstile | undefined;
        let loader: Promise<Turnstile> | undefined;
        const loadTurnstile = () =>
          (loader ??= new Promise<Turnstile>((resolve, reject) => {
            const script = document.createElement('script');
            script.src =
              'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
            script.async = true;
            script.onload = () => {
              const value = (window as unknown as { turnstile?: Turnstile })
                .turnstile;
              if (value) resolve(value);
              else reject(new Error('Turnstile unavailable'));
            };
            script.onerror = () => reject(new Error('Turnstile failed'));
            document.head.append(script);
          }));
        const start = () =>
          loadTurnstile()
            .then((turnstile) => {
              api = turnstile;
              if (widget !== undefined) return;
              widget = turnstile.render(slot, {
                sitekey: root!.dataset.sitekey,
                language: locale,
                callback: (value: string) => (token = value),
                'expired-callback': () => (token = ''),
                'error-callback': () => (token = ''),
              });
            })
            .catch(() => (status.textContent = errors.verification_failed));
        const post = async (path: string, body: Record<string, unknown>) => {
          const response = await fetch(path, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error ?? 'failed');
          return data;
        };
        const showEmailStep = (clear: boolean) => {
          codeForm.hidden = true;
          emailForm.hidden = false;
          if (clear) emailInput.value = '';
          token = '';
          api?.reset(widget);
          emailInput.focus();
        };

        emailForm.addEventListener('focusin', start, { once: true });
        emailForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!emailForm.checkValidity()) return emailForm.reportValidity();
          if (!token) {
            start();
            status.textContent = copy.verifying;
            return;
          }
          const button = emailForm.querySelector('button')!;
          button.disabled = true;
          status.textContent = copy.sending;
          try {
            await post('/api/auth/email/start', {
              email: emailInput.value,
              locale,
              token,
            });
            status.textContent = '';
            codeForm.querySelector('[data-code-sent]')!.textContent =
              copy.codeSent.replace('{email}', emailInput.value.trim());
            emailForm.hidden = true;
            codeForm.hidden = false;
            codeInput.value = '';
            codeInput.focus();
          } catch (error) {
            status.textContent =
              errors[(error as Error).message] ?? errors.mail_failed;
            token = '';
            api?.reset(widget);
          } finally {
            button.disabled = false;
          }
        });
        codeForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!codeForm.checkValidity()) return codeForm.reportValidity();
          const button = codeForm.querySelector<HTMLButtonElement>(
            'button[type=submit]',
          )!;
          button.disabled = true;
          try {
            const data = await post('/api/auth/email/verify', {
              email: emailInput.value,
              code: codeInput.value,
              return: safeBack ?? root!.dataset.account,
            });
            location.replace(data.return);
          } catch (error) {
            status.textContent =
              errors[(error as Error).message] ?? errors.invalid_code;
            button.disabled = false;
          }
        });
        codeForm
          .querySelector('[data-resend]')!
          .addEventListener('click', () => showEmailStep(false));
        codeForm
          .querySelector('[data-change]')!
          .addEventListener('click', () => showEmailStep(true));
        block.hidden = false;
      }
    } else {
      const body = root.querySelector<HTMLElement>('[data-account-body]')!;
      const form = root.querySelector<HTMLFormElement>('[data-name-form]')!;
      const input = form.querySelector<HTMLInputElement>('input')!;
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      me.then((data) => {
        if (!data.user) return location.replace(root.dataset.login!);
        root.querySelector('[data-email]')!.textContent = data.user.email;
        input.value = data.user.displayName;
        body.hidden = false;
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.checkValidity()) return form.reportValidity();
        const response = await fetch('/api/me', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ displayName: input.value }),
        }).catch(() => null);
        status.textContent = response?.ok ? copy.saved : copy.failed;
      });
      root
        .querySelector('[data-sign-out]')!
        .addEventListener('click', async () => {
          await fetch('/api/auth/logout', { method: 'POST' }).catch(() => null);
          location.replace(root.dataset.home!);
        });
      root
        .querySelector('[data-delete]')!
        .addEventListener('click', async () => {
          if (!confirm(copy.deleteConfirm)) return;
          const result = root.querySelector<HTMLElement>(
            '[data-delete-status]',
          )!;
          const response = await fetch('/api/me', { method: 'DELETE' }).catch(
            () => null,
          );
          if (!response?.ok) {
            result.textContent = copy.failed;
            return;
          }
          result.textContent = copy.deleted;
          setTimeout(() => location.replace(root.dataset.home!), 1500);
        });
    }
  }
</script>
