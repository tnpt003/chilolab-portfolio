---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { pathFor } from '../lib/content';
import {
  alwaysLatest,
  featuredDownload,
  versionCopy,
  versionPath,
} from '../lib/versions';
import DownloadCounter from './DownloadCounter.astro';
import Comments from './Comments.astro';
import { feedbackPath } from '../lib/community';
interface Props {
  entry: CollectionEntry<'versions'>;
  project: CollectionEntry<'projects'>;
}
const { entry, project } = Astro.props;
const { data } = entry;
const t = versionCopy[data.locale];
const { Content } = await render(entry);
const latest = (
  await featuredDownload(
    data.locale,
    data.project,
    project.data.featuredVersion,
  )
)?.data;
---

<Base
  title={`${project.data.title} ${data.version} — ${data.title}`}
  tab={`${project.data.title} ${data.version} · chilolab.com`}
  description={data.summary}
  locale={data.locale}
  slug={`${data.project}/versions/${data.version}`}
>
  <div class="wrap version-page">
    <a class="back" href={versionPath(data.locale, data.project)}>
      ← {t.all}
    </a>
    <header class="detail-heading">
      <a href={pathFor(data.locale, data.project)}>{project.data.title}</a>
      <div class="version-meta">
        <span class="version-status">{t[data.status]}</span>
        {data.releasedAt && (
          <span>
            {t.date}: <time datetime={data.releasedAt}>{data.releasedAt}</time>
          </span>
        )}
      </div>
      <h1>v{data.version}</h1>
      <p class="version-title">{data.title}</p>
      <p class="lead">{data.summary}</p>
      {data.status !== 'released' && <p class="version-notice">{t.pending}</p>}
      <div class="actions">
        {/* Version pages never link to old builds, only to the newest one. */}
        {latest && (
          <a
            class="button"
            href={alwaysLatest(latest.downloadUrl!)}
            data-download={`${data.project}/${latest.version}/setup`}
          >
            {t.downloadLatest}
          </a>
        )}
        <a href="#comments">{t.discuss}</a>
        <a href={feedbackPath(data.locale, data.project)}>{t.feedback}</a>
      </div>
    </header>
    <article class="prose version-article">
      <Content />
    </article>
    <nav class="version-bottom" aria-label={t.heading}>
      <a href={versionPath(data.locale, data.project)}>{t.all}</a>
      <a href={pathFor(data.locale, data.project)}>{t.back}</a>
    </nav>
    <Comments
      locale={data.locale}
      project={data.project}
      version={data.version}
    />
  </div>
  <DownloadCounter />
</Base>
