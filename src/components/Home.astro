---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import ProjectVisual from './ProjectVisual.astro';
import portrait from '../assets/phat-portrait.jpg';
import { listProjects, pathFor, copy, type Locale } from '../lib/content';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const projects = await listProjects(locale);
---

<Base
  title={locale === 'vi' ? 'Những dự án của tôi' : 'My projects'}
  description={t.intro}
  locale={locale}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{t.title}</h1>
      <p class="lead">{t.intro}</p>
      <a class="button" href="#projects">
        {t.explore}
      </a>
    </div>
    <figure class="portrait">
      <Image
        src={portrait}
        alt={t.portraitAlt}
        widths={[320, 500]}
        sizes="(max-width: 720px) 80vw, 400px"
        format="webp"
        loading="eager"
      />
      <figcaption>{t.portraitCaption}</figcaption>
    </figure>
  </section>
  <section class="projects wrap" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">{t.projects}</h2>
      <p>{t.selected}</p>
    </div>
    <div class="project-list">
      {projects.map(({ data }) => (
        <article class="project">
          <a class="project-link" href={pathFor(locale, data.slug)}>
            <ProjectVisual
              kind={data.kind}
              label={t.preview}
              preview={data.preview}
            />
            <div class="project-copy">
              <h3>{data.title}</h3>
              <p>{data.description}</p>
              <span class="text-link">{t.detail}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="about wrap" id="about">
    <h2>{t.about}</h2>
    <p>{t.aboutText}</p>
  </section>
</Base>
