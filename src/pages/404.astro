---
import Base from '../layouts/Base.astro';
import { getUi } from '../lib/content';
const vi = (await getUi('vi')).chrome;
const en = (await getUi('en')).chrome;
---

<Base
  title={`${vi.notFoundTitle} / ${en.notFoundTitle}`}
  tab={`${vi.notFoundTitle} · chilolab.com`}
  description={`${vi.notFoundDescription} / ${en.notFoundDescription}`}
  locale="vi"
  noindex
>
  <section class="wrap error">
    <p>404</p>
    <h1>{vi.notFound}</h1>
    <p lang="en">{en.notFound}</p>
    <div class="actions">
      <a class="button" href="/">
        {vi.notFoundHome}
      </a>
      <a href="/en" lang="en">
        {en.notFoundHome}
      </a>
    </div>
  </section>
</Base>
