---
import Base from '../layouts/Base.astro';
---

<Base
  title="Không tìm thấy trang / Page not found"
  description="Trang bạn tìm không tồn tại. / This page does not exist."
  locale="vi"
  noindex
>
  <section class="wrap error">
    <p>404</p>
    <h1>Trang này chưa có ở đây.</h1>
    <p lang="en">This page doesn't exist.</p>
    <div class="actions">
      <a class="button" href="/">
        Về trang chủ
      </a>
      <a href="/en" lang="en">
        Home in English
      </a>
    </div>
  </section>
</Base>
