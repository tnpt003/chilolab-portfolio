---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource/be-vietnam-pro/800.css';
import '../styles/global.css';
import {
  getProfile,
  getUi,
  listProjects,
  pathFor,
  type Locale,
} from '../lib/content';
import { feedbackPath, privacyPath, userPath } from '../lib/community';
import { versionPath } from '../lib/versions';
import { feedPath } from '../lib/feed';
import { email, githubUrl } from '../lib/profile';
import { getImage } from 'astro:assets';
import shareImage from '../assets/pet-battle-hub.png';
import Logo from '../components/Logo.astro';
interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug?: string;
  noindex?: boolean;
  /** Browser tab text; defaults to the title followed by the domain. */
  tab?: string;
}
const {
  title,
  description,
  locale,
  slug = '',
  noindex = false,
  tab = `${title} · chilolab.com`,
} = Astro.props;
const ui = await getUi(locale);
const t = ui.site;
const other = locale === 'vi' ? 'en' : 'vi';
const canonical = new URL(pathFor(locale, slug), Astro.site);
const projects = await listProjects(locale);
const f = t.footerLinks;
// Link previews (Facebook, Zalo, Discord…). JPEG because some crawlers
// still skip WebP; only crawlers fetch it, visitors never download it.
const og = await getImage({ src: shareImage, width: 1200, format: 'jpeg' });
const ogImage = new URL(og.src, Astro.site);
// Structured data for search engines: who the owner is (home and About)
// and the site itself (home). Only facts the pages already show.
const me = await getProfile(locale);
const person = {
  '@type': 'Person',
  '@id': `${Astro.site}#owner`,
  name: 'Nguyễn Tấn Phát',
  url: new URL(pathFor(locale, 'about'), Astro.site).href,
  jobTitle: me.role,
  worksFor: { '@type': 'Organization', name: me.company },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Ho Chi Minh City University of Foreign Languages and Information Technology (HUFLIT)',
  },
  email: `mailto:${email}`,
  sameAs: [githubUrl],
};
const structured =
  slug === ''
    ? [
        {
          '@type': 'WebSite',
          name: 'ChiloLab',
          url: new URL(pathFor(locale), Astro.site).href,
          inLanguage: locale,
          author: { '@id': person['@id'] },
        },
        person,
      ]
    : slug === 'about'
      ? [person]
      : [];
// Escape "<" so the JSON can never close the script element.
const jsonLd = structured.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': structured,
    }).replaceAll('<', '\\u003c')
  : '';
const ogAlt =
  locale === 'vi'
    ? 'Giao diện Pet Desktop trên desktop Windows'
    : 'Pet Desktop on a Windows desktop';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tab}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link
          rel="alternate"
          hreflang="vi"
          href={new URL(pathFor('vi', slug), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(pathFor('en', slug), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(pathFor('vi', slug), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ChiloLab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:site_name" content="ChiloLab" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#184b58" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={
        locale === 'vi'
          ? 'ChiloLab: ghi chú phiên bản'
          : 'ChiloLab: version notes'
      }
      href={feedPath(locale)}
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">
      {locale === 'vi' ? 'Đến nội dung' : 'Skip to content'}
    </a>
    <div
      class="owner-bar"
      data-owner-bar
      data-pending={
        locale === 'vi'
          ? '{held} bình luận chờ duyệt · {feedback} góp ý mới'
          : '{held} held comments · {feedback} new feedback'
      }
      hidden
    >
      <div class="wrap">
        <strong>{locale === 'vi' ? 'Chế độ chủ site' : 'Owner mode'}</strong>
        <span class="owner-bar-note">
          {locale === 'vi'
            ? 'Khách không thấy dải này.'
            : 'Visitors do not see this bar.'}
        </span>
        <a href="/admin/manage" data-owner-pending></a>
        <a href="/admin/manage">
          {locale === 'vi' ? 'Mở trang quản trị' : 'Open the admin panel'}
        </a>
      </div>
    </div>
    <header class="header wrap">
      <a class="brand" href={pathFor(locale)}>
        <Logo />
        ChiloLab
      </a>
      <nav
        aria-label={locale === 'vi' ? 'Điều hướng chính' : 'Main navigation'}
      >
        <a href={`${pathFor(locale)}#projects`}>{t.projects}</a>
        <a
          href={pathFor(locale, 'about')}
          aria-current={slug === 'about' ? 'page' : undefined}
        >
          {t.me}
        </a>
        <a
          class="language"
          href={pathFor(other, slug)}
          lang={other}
          hreflang={other}
        >
          {t.switch}
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href={pathFor(locale)}>
            <Logo />
            ChiloLab
          </a>
          <p>{t.footer}</p>
        </div>
        <nav aria-label={f.projects}>
          <p class="footer-title">{f.projects}</p>
          <ul>
            {projects.map(({ data }) => (
              <li>
                <a href={pathFor(locale, data.slug)}>{data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Pet Desktop">
          <p class="footer-title">Pet Desktop</p>
          <ul>
            <li>
              <a href={`${pathFor(locale, 'pet-desktop')}#download-heading`}>
                {f.download}
              </a>
            </li>
            <li>
              <a href={versionPath(locale, 'pet-desktop')}>{f.versions}</a>
            </li>
            <li>
              <a href={feedbackPath(locale, 'pet-desktop')}>{f.feedback}</a>
            </li>
          </ul>
        </nav>
        <nav aria-label="ChiloLab">
          <p class="footer-title">ChiloLab</p>
          <ul>
            <li>
              <a href={pathFor(locale, 'about')}>{t.me}</a>
            </li>
            <li>
              <a href={`${pathFor(locale)}#about`}>{t.about}</a>
            </li>
            <li>
              <a href={privacyPath(locale)}>{f.privacy}</a>
            </li>
            <li>
              <a href={userPath(locale, 'login')}>{f.account}</a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} Nguyễn Tấn Phát, ChiloLab</span>
      </div>
    </footer>
    <script>
      // Owner bar: only asked for when the owner hint cookie is present
      // (set by /admin/manage and /api/me), so visitors never trigger the request.
      // The answer from /api/me decides; the cookie alone shows nothing.
      const bar = document.querySelector<HTMLElement>('[data-owner-bar]');
      if (bar && document.cookie.includes('__Host-chilolab_admin=1'))
        fetch('/api/me')
          .then((response) => (response.ok ? response.json() : null))
          .then((data) => {
            if (!data?.user?.owner) return;
            const pending = bar.querySelector<HTMLElement>(
              '[data-owner-pending]',
            )!;
            const { held = 0, feedback = 0 } = data.pending ?? {};
            if (held || feedback)
              pending.textContent = bar.dataset
                .pending!.replace('{held}', String(held))
                .replace('{feedback}', String(feedback));
            else pending.remove();
            bar.hidden = false;
          })
          .catch(() => {});
    </script>
  </body>
</html>
